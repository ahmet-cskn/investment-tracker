# Copy this file to `.env` and fill it in. `.env` is git-ignored, and Docker Compose reads it automatically.
# Never put a real key in this example file.

# Free key from https://www.alphavantage.co/support/#api-key (about 20 seconds, no credit card).
# Optional: without it the app runs normally, but prices (and so worth) are unavailable.
ALPHAVANTAGE_API_KEY=
